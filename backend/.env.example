# MongoDB — local for development, MongoDB Atlas SRV string in production
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=khadamni

# JWT
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email (Gmail app password, not your account password)
MAIL_USERNAME=khadamni303@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=khadamni303@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# AI chat
GROQ_API_KEY=your_groq_api_key

# Supabase Storage — leave blank to keep uploads on local disk
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Extra allowed browser origins (only if the frontend is hosted separately)
CORS_ORIGINS=

# Path to the built frontend; blank means backend/static
STATIC_DIR=
